{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Bash(bun *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(nc *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm --filter * dlx *)",
      "Bash(pnpm --filter * exec *)",
      "Bash(pnpm -r exec *)",
      "Bash(pnpm dlx *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -rf *)",
      "Bash(rsync *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(yarn *)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/.env)",
      "Read(./**/.npmrc)",
      "Read(./**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Write(./**/*.key)",
      "Write(./**/*.pem)",
      "Write(./**/.env)",
      "Write(./**/.npmrc)",
      "Write(./**/secrets/**)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(gh *)",
      "Bash(rm *)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)"
    ],
    "allow": [
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(cp *)",
      "Bash(curl *)",
      "Bash(cut *)",
      "Bash(date *)",
      "Bash(diff *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(node *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:css)",
      "Bash(pnpm lint:js)",
      "Bash(pnpm preview)",
      "Bash(pnpm why *)",
      "Bash(python3 *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(touch *)",
      "Bash(tr *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git push",
      "git push *"
    ],
    "filesystem": {
      "denyRead": [
        "./**/*.key",
        "./**/*.p12",
        "./**/*.pem",
        "./**/*.pfx",
        "./**/*secret*",
        "./**/.env",
        "./**/.npmrc",
        "./**/credentials.json",
        "./**/id_ed25519*",
        "./**/id_rsa*",
        "./**/secrets/"
      ],
      "denyWrite": [
        "./**/*.key",
        "./**/*.pem",
        "./**/.env",
        "./**/.npmrc",
        "./**/secrets/",
        "./.claude/settings.json"
      ]
    },
    "network": {
      "allowedDomains": ["*.schemastore.org", "registry.npmjs.org"]
    }
  }
}
